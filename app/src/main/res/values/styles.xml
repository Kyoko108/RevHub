<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#A78BFA</item>
        <item name="android:navigationBarColor">#0D111B</item>
        <item name="android:statusBarColor">#0D111B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!-- Android 15 enforces edge-to-edge for targetSdk 35; opt out so the WebView
             is laid out in the safe area and never beneath the camera/status bar. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
